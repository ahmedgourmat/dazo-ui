{
  "name": "dazo-ui",
  "version": "1.0.2",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/web/index.cjs",
  "module": "./dist/web/index.js",
  "react-native": "./dist/native/index.js",
  "types": "./dist/web/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "import": {
          "types": "./dist/web/index.d.ts",
          "default": "./dist/native/index.js"
        },
        "require": {
          "types": "./dist/web/index.d.cts",
          "default": "./dist/native/index.cjs"
        },
        "default": {
          "types": "./dist/web/index.d.ts",
          "default": "./dist/native/index.js"
        }
      },
      "browser": {
        "import": {
          "types": "./dist/web/index.d.ts",
          "default": "./dist/web/index.js"
        },
        "require": {
          "types": "./dist/web/index.d.cts",
          "default": "./dist/web/index.cjs"
        },
        "default": {
          "types": "./dist/web/index.d.ts",
          "default": "./dist/web/index.js"
        }
      },
      "import": {
        "types": "./dist/web/index.d.ts",
        "default": "./dist/web/index.js"
      },
      "require": {
        "types": "./dist/web/index.d.cts",
        "default": "./dist/web/index.cjs"
      },
      "default": {
        "types": "./dist/web/index.d.ts",
        "default": "./dist/web/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && rolldown -c && node scripts/emit-cjs-types.js",
    "dev": "rolldown -c --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.81.5",
    "react-native-web": ">=0.19.0"
  },
  "peerDependenciesMeta": {
    "react-native-web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "react-native": "0.81.5",
    "rolldown": "^1.3.0",
    "rolldown-plugin-dts": "^0.30.0",
    "typescript": "^5.3.0"
  }
}
