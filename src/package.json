{
  "name": "dazo-ui",
  "version": "2.1.0",
  "description": "Minimal, theme-aware UI components for React Native and the web, from one API.",
  "license": "MIT",
  "author": "ahmedgourmat (https://github.com/ahmedgourmat)",
  "homepage": "https://github.com/ahmedgourmat/dazo-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmedgourmat/dazo-ui.git",
    "directory": "src"
  },
  "bugs": {
    "url": "https://github.com/ahmedgourmat/dazo-ui/issues"
  },
  "keywords": [
    "react-native",
    "react-native-web",
    "react",
    "expo",
    "ui",
    "components",
    "component-library",
    "design-system",
    "cross-platform",
    "theme",
    "dark-mode",
    "accessibility",
    "typescript"
  ],
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/web/index.cjs",
  "module": "./dist/web/index.js",
  "react-native": "./dist/native/index.js",
  "types": "./dist/web/index.d.ts",
  "typesVersions": {
    "*": {
      "server": ["./dist/web/server/index.d.ts"],
      "next": ["./dist/web/server/next.d.ts"]
    }
  },
  "exports": {
    ".": {
      "react-native": {
        "import": {
          "types": "./dist/web/index.d.ts",
          "default": "./dist/native/index.js"
        },
        "require": {
          "types": "./dist/web/index.d.cts",
          "default": "./dist/native/index.cjs"
        },
        "default": {
          "types": "./dist/web/index.d.ts",
          "default": "./dist/native/index.js"
        }
      },
      "browser": {
        "import": {
          "types": "./dist/web/index.d.ts",
          "default": "./dist/web/index.js"
        },
        "require": {
          "types": "./dist/web/index.d.cts",
          "default": "./dist/web/index.cjs"
        },
        "default": {
          "types": "./dist/web/index.d.ts",
          "default": "./dist/web/index.js"
        }
      },
      "import": {
        "types": "./dist/web/index.d.ts",
        "default": "./dist/web/index.js"
      },
      "require": {
        "types": "./dist/web/index.d.cts",
        "default": "./dist/web/index.cjs"
      },
      "default": {
        "types": "./dist/web/index.d.ts",
        "default": "./dist/web/index.js"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/web/server/index.d.ts",
        "default": "./dist/web/server/index.js"
      },
      "require": {
        "types": "./dist/web/server/index.d.cts",
        "default": "./dist/web/server/index.cjs"
      },
      "default": {
        "types": "./dist/web/server/index.d.ts",
        "default": "./dist/web/server/index.js"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/web/server/next.d.ts",
        "default": "./dist/web/server/next.js"
      },
      "require": {
        "types": "./dist/web/server/next.d.cts",
        "default": "./dist/web/server/next.cjs"
      },
      "default": {
        "types": "./dist/web/server/next.d.ts",
        "default": "./dist/web/server/next.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && rolldown -c && node scripts/emit-cjs-types.js",
    "prepack": "node scripts/copy-root-docs.js",
    "dev": "rolldown -c --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "publint --strict && attw --pack .",
    "size": "size-limit"
  },
  "peerDependencies": {
    "next": ">=13.4.0",
    "react": ">=19.0.0",
    "react-native": ">=0.81.5",
    "react-native-web": ">=0.19.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react-native-web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.4",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.14",
    "axe-core": "^4.14.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "jsdom": "^31.0.1",
    "publint": "^0.3.25",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.2",
    "rolldown": "^1.3.0",
    "rolldown-plugin-dts": "^0.30.0",
    "size-limit": "^14.3.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
